ANTHROPIC_API_KEY=hier-Schluessel-eintragen
# Modell fürs Übersetzen und fürs Abschreiben von Fotos/Scans/PDFs (Standard: claude-haiku-5-5).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modell fürs Gespräch mit dem Avatar (Standard: claude-sonnet-5-5).
ANTHROPIC_MODEL_GESPRAECH=claude-sonnet-5-5

# Administrator und Demo-Nutzer. Beim Serverstart werden die Passwörter aus .env übernommen,
# wenn sie vom gespeicherten Stand abweichen (Entwicklungsphase, mind. 4 Zeichen). Beide bekommen Test-Patient p2.
ADMIN_USER=admin
ADMIN_PASSWORD=hier-eigenes-Passwort-eintragen
DEMO_USER=demo
DEMO_PASSWORD=hier-eigenes-Passwort-eintragen

# Wissensspeicher (Arztbriefe der Test-Patienten in lokal/patienten/, Antworten mit Quellen):
# Vor der Suche Suchbegriffe per Claude ergänzen? an|aus (Standard: aus – ca. 1–2 s schneller bis zum ersten Satz)
#RAG_ERWEITERN=aus
# Zeitlimit dafür in Millisekunden (Standard 1200) und Modell (Standard claude-haiku-5-5)
#RAG_ERWEITERN_MS=1200
#ANTHROPIC_MODEL_SUCHE=claude-haiku-5-5

# Fuers Handy im WLAN: HOST=0.0.0.0 (Standard: nur dieser Rechner)
#HOST=127.0.0.1
#PORT=3000

# D-ID Avatar (Schluessel aus studio.d-id.com, Format API_USERNAME:API_PASSWORD)
DID_API_KEY=hier-Schluessel-eintragen
# optional: feste Agent-ID für den Standard-Avatar (Emma), sonst legt der Server
# pro Avatar einmalig einen an und merkt ihn in lokal/did-agents.json
#DID_AGENT_ID=

# D-ID-Studio-Agents je Profilsprache, IDs aus studio.d-id.com. D-ID liefert nur Gesicht und Stimme,
# die Antworten kommen von Claude (Systemprompt prompt/gespraech.md + hochgeladene Unterlagen).
DID_AGENT_DE=
# optional: weitere Studio-Agents derselben Sprache (kommagetrennt), erscheinen zusätzlich in der Avatar-Auswahl
#DID_AGENTEN_DE=

# Avatare und ihre Sprachen frei festlegen (ersetzt DID_AGENT_DE / DID_AGENTEN_DE, wenn gesetzt):
# kommagetrennte Liste aus  Agent-ID:Sprachen  – Sprachen mit + verbunden (de, en, fr).
# Die Reihenfolge ist die Reihenfolge in der Avatar-Auswahl. In der App erscheinen nur Avatare,
# die die Profilsprache können. Für Englisch/Französisch einen Agent mit mehrsprachiger Stimme
# nehmen (Microsoft-Stimmen mit „Multilingual“ im Namen).
#DID_AVATARE=v2_agt_AAAA:de+en+fr,v2_agt_BBBB:de
# optional: welcher Avatar vorausgewählt ist (sonst der erste, der die Profilsprache kann)
#DID_AVATAR_STANDARD=v2_agt_AAAA
# Ein Avatar in mehreren Sprachen (pro Sprache ein eigener D-ID-Agent) als Gruppe „name=agentId:sprache“.
# Die App zeigt EINEN Avatar; die Profilsprache wählt den Agenten. Sprachen: de, en, fr, tr, ar.
#DID_AVATARE=mitano=v2_agt_AAAA:de,mitano=v2_agt_BBBB:en,mitano=v2_agt_CCCC:fr
# Hybrid-Gespräch: Weiche „nativ“ (D-ID-Agent) oder „claude“ (Unterlagen). Modell und Zeitlimit der Weiche:
#WEG_MODELL=claude-haiku-5-5
#WEG_TIMEOUT_MS=900
#DID_AGENT_EN=
#DID_AGENT_FR=
