+
+/// mitano.-Patch: gemeinsame, stabile Audio-Sitzung für Spracherkennung + WKWebView/WebRTC-Wiedergabe.
+/// Kategorie playAndRecord mit Lautsprecher, Bluetooth-A2DP und mixWithOthers; Modus nur bei Bedarf ändern;
+/// setActive(true) nur einmal pro App-Lauf; niemals deaktivieren.
+enum MitanoAudioSession {
+    static var requestedMode: AVAudioSession.Mode = .default
+    private static var aktiviert = false
+
+    static func ensure() throws {
+        let session = AVAudioSession.sharedInstance()
+        let options: AVAudioSession.CategoryOptions = [.defaultToSpeaker, .allowBluetoothA2DP, .mixWithOthers]
+        if session.category != .playAndRecord || session.mode != requestedMode || !session.categoryOptions.contains(.defaultToSpeaker) {
+            try session.setCategory(.playAndRecord, mode: requestedMode, options: options)
+        }
+        if !aktiviert {
+            try session.setActive(true)
+            aktiviert = true
+        }
+    }
+}
